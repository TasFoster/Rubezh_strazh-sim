{
  "name": "rubezh-strazh-sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Симулятор монтажа и пусконаладки СКУД Rubezh STRAZH",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @strazh-sim/web",
    "build": "npm run build -w @strazh-sim/web && node scripts/generate-service-worker.mjs",
    "preview": "npm run preview -w @strazh-sim/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.packages.json && tsc -p apps/web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && playwright test --config playwright.production.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
